root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# Wave 0 skeleton: silence two opinionated wrapping rules that add churn without
# improving readability at this stage. Revisit as product code lands (later waves).
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled
# @Composable functions are intentionally PascalCase (Android/Compose convention),
# which the standard function-naming rule flags. Disable it project-wide; detekt's
# FunctionNaming (with a Composable/Test exemption) still guards ordinary names.
ktlint_standard_function-naming = disabled
# ktlint_official forces every function with >= 2 parameters onto a multiline
# signature even when it fits well within max_line_length, which adds noise to the
# many small 2-3 param functions in the engine/seam (openReader, read, setSource, …).
# Raise the count threshold so signatures under 120 cols stay on one line; the
# length-based wrapping above still splits genuinely long signatures. (`unset` here
# would revert to the ktlint_official default of 2, so an explicit high value is used.)
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 10

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,toml,xml,json}]
indent_size = 2
